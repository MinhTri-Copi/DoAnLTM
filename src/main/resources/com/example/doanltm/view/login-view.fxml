<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.doanltm.Controller.LoginController"
            prefHeight="500.0" prefWidth="400.0"
            style="-fx-background-color: #f5f5f5;">

    <VBox alignment="CENTER" spacing="20.0" AnchorPane.topAnchor="50.0" 
          AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0">
        
        <!-- Header -->
        <VBox alignment="CENTER" spacing="5.0">
            <Label text="Hệ thống Quản lý" style="-fx-text-fill: #2c3e50;">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>
            <Label text="Đăng ký và Lịch Làm Việc" style="-fx-text-fill: #34495e;">
                <font>
                    <Font size="16.0"/>
                </font>
            </Label>
        </VBox>
        
        <!-- Login Form -->
        <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; 
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <padding>
                <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
            </padding>
            
            <Label text="Đăng Nhập" style="-fx-text-fill: #2c3e50;">
                <font>
                    <Font name="System Bold" size="20.0"/>
                </font>
            </Label>
            
            <!-- Email Field -->
            <VBox spacing="5.0">
                <Label text="Email:" style="-fx-text-fill: #555;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Label>
                <TextField fx:id="emailField" promptText="Nhập email của bạn"
                          style="-fx-background-radius: 5; -fx-border-radius: 5; 
                                 -fx-border-color: #ddd; -fx-padding: 10;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </TextField>
            </VBox>
            
            <!-- Password Field -->
            <VBox spacing="5.0">
                <Label text="Mật khẩu:" style="-fx-text-fill: #555;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Label>
                <HBox spacing="8.0">
                    <StackPane HBox.hgrow="ALWAYS">
                        <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu"
                                      style="-fx-background-radius: 5; -fx-border-radius: 5; 
                                             -fx-border-color: #ddd; -fx-padding: 10;">
                            <font>
                                <Font size="14.0"/>
                            </font>
                        </PasswordField>
                        <TextField fx:id="passwordVisibleField" promptText="Nhập mật khẩu"
                                  style="-fx-background-radius: 5; -fx-border-radius: 5; 
                                         -fx-border-color: #ddd; -fx-padding: 10;"
                                  visible="false" managed="false">
                            <font>
                                <Font size="14.0"/>
                            </font>
                        </TextField>
                    </StackPane>
                    <Button fx:id="togglePasswordButton" text="👁️" onAction="#handleTogglePassword"
                           style="-fx-background-color: #ecf0f1; -fx-background-radius: 5; 
                                  -fx-border-radius: 5; -fx-border-color: #ddd; -fx-padding: 10;"
                           prefWidth="40.0" prefHeight="40.0">
                        <font>
                            <Font size="12.0"/>
                        </font>
                    </Button>
                </HBox>
            </VBox>
            
            <!-- Remember Me Checkbox -->
            <CheckBox fx:id="rememberMeCheckbox" text="Ghi nhớ đăng nhập" 
                     style="-fx-text-fill: #555;">
                <font>
                    <Font size="12.0"/>
                </font>
            </CheckBox>
            
            <!-- Error Label -->
            <Label fx:id="errorLabel" textFill="RED" wrapText="true" visible="false">
                <font>
                    <Font size="12.0"/>
                </font>
            </Label>
            
            <!-- Login Button -->
            <Button fx:id="loginButton" text="ĐĂNG NHẬP" onAction="#handleLogin"
                   maxWidth="Infinity" prefHeight="40.0"
                   style="-fx-background-color: #3498db; -fx-text-fill: white; 
                          -fx-background-radius: 5; -fx-font-weight: bold;">
                <font>
                    <Font size="14.0"/>
                </font>
            </Button>
            
            <!-- Register Link -->
            <HBox spacing="6.0" alignment="CENTER">
                <Label text="Chưa có tài khoản?" style="-fx-text-fill: #555;" />
                <Hyperlink text="Đăng ký" onAction="#handleOpenRegister" />
            </HBox>

            <!-- Server Status -->
            <HBox spacing="10.0" alignment="CENTER">
                <Label text="Trạng thái server:" style="-fx-text-fill: #555;">
                    <font>
                        <Font size="12.0"/>
                    </font>
                </Label>
                <Label fx:id="serverStatusLabel" text="Đang kiểm tra..." 
                      style="-fx-text-fill: #f39c12;">
                    <font>
                        <Font size="12.0"/>
                    </font>
                </Label>
            </HBox>
        </VBox>
        
        <!-- Footer -->
        <Label text="© 2025 - Đồ án Lập trình Mạng" style="-fx-text-fill: #95a5a6;">
            <font>
                <Font size="11.0"/>
            </font>
        </Label>
    </VBox>
</AnchorPane>
