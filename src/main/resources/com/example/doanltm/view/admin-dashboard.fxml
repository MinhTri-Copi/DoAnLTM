<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.doanltm.Controller.AdminDashboardController"
            prefWidth="1200.0" prefHeight="800.0"
            stylesheets="@../styles/admin.css">

    <!-- Header -->
    <top>
        <HBox styleClass="admin-header" alignment="CENTER_LEFT" spacing="18">
            <Label text="🛡️" styleClass="logo"/>
            <VBox spacing="2">
                <Label fx:id="titleLabel" styleClass="header-title" text="Hệ thống quản lí làm việc"/>
                <Label text="Admin Panel" styleClass="header-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="header-controls">
                <Button text="Làm mới dữ liệu" onAction="#handleRefreshData" styleClass="reload-btn"/>
                <Button text="Đăng xuất" onAction="#handleLogout" styleClass="logout-btn"/>
            </HBox>
        </HBox>
    </top>

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="8">
            <Label text="Bảng điều khiển" styleClass="sidebar-title"/>
            <Button text="📊  Tổng quan" styleClass="sidebar-btn active" onAction="#showOverview"/>
            <Button text="🗓️  Quản lí ca làm việc" styleClass="sidebar-btn" onAction="#showShiftManagement"/>
            <Button text="👥  Quản lí người dùng" styleClass="sidebar-btn" onAction="#showUserManagement"/>
            <Button text="🗂️  Quản lí lịch" styleClass="sidebar-btn" onAction="#showScheduleManagement"/>
        </VBox>
    </left>

    <!-- Content -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
            <VBox styleClass="content" spacing="18">

                <!-- Stats Cards (đẹp hơn) -->
                <HBox spacing="18">
                    <VBox styleClass="card stat-card stat-blue" VBox.vgrow="NEVER">
                        <Label text="Tổng ca trong tháng" styleClass="stat-title"/>
                        <Label fx:id="monthlyTotalLabel" styleClass="stat-number" text="0"/>
                    </VBox>
                    <VBox styleClass="card stat-card stat-green" VBox.vgrow="NEVER">
                        <Label text="Ngày đăng ký cao nhất" styleClass="stat-title"/>
                        <Label fx:id="highestDayLabel" styleClass="stat-sub" text="N/A"/>
                    </VBox>
                    <VBox styleClass="card stat-card stat-amber" VBox.vgrow="NEVER">
                        <Label text="Ngày đăng ký thấp nhất" styleClass="stat-title"/>
                        <Label fx:id="lowestDayLabel" styleClass="stat-sub" text="N/A"/>
                    </VBox>
                </HBox>

                <!-- Filters -->
                <HBox styleClass="filter-bar" spacing="10" alignment="CENTER_LEFT">
                    <Label text="Bộ lọc:" styleClass="label"/>
                    <ComboBox fx:id="caFilterCombo" promptText="Lọc theo ca"/>
                    <DatePicker fx:id="ngayFilterPicker" promptText="Lọc theo ngày"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Áp dụng" onAction="#handleApplyFilters" styleClass="primary-btn"/>
                    <Button text="Xóa lọc" onAction="#handleClearFilters" styleClass="danger-btn"/>
                </HBox>

                <!-- Registrations Table -->
                <VBox styleClass="card" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="card-header-line">
                        <Label text="Danh sách đăng ký" styleClass="card-title"/>
                    </HBox>
                    <TableView fx:id="regTable" VBox.vgrow="ALWAYS" prefHeight="520.0">
                        <columns>
                            <TableColumn fx:id="colNguoiDung" text="Người dùng" prefWidth="160"/>
                            <TableColumn fx:id="colNgay" text="Ngày" prefWidth="110"/>
                            <TableColumn fx:id="colMoTa" text="Mô tả ca" prefWidth="240"/>
                            <TableColumn fx:id="colLoaiCa" text="Loại ca" prefWidth="120"/>
                            <TableColumn fx:id="colTrangThai" text="Trạng thái" prefWidth="120"/>
                            <TableColumn fx:id="colActions" text="Thao tác" prefWidth="280"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
