<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.doanltm.Controller.RegisterController"
            prefHeight="600.0" prefWidth="400.0"
            style="-fx-background-color: #f5f5f5;">

    <VBox alignment="CENTER" spacing="20.0" AnchorPane.topAnchor="30.0" 
          AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0">
        
        <!-- Header -->
        <VBox alignment="CENTER" spacing="5.0">
            <Label text="Đăng Ký Tài Khoản" style="-fx-text-fill: #2c3e50;">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>
            <Label text="Hệ thống Quản lý Lịch Làm Việc" style="-fx-text-fill: #34495e;">
                <font>
                    <Font size="14.0"/>
                </font>
            </Label>
        </VBox>
        
        <!-- Register Form -->
        <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; 
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <padding>
                <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
            </padding>
            
            <!-- Full Name Field -->
            <VBox spacing="5.0">
                <Label text="Họ và tên:*" style="-fx-text-fill: #555;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Label>
                <TextField fx:id="fullNameField" promptText="Nhập họ và tên đầy đủ"
                          style="-fx-background-radius: 5; -fx-border-radius: 5; 
                                 -fx-border-color: #ddd; -fx-padding: 10;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </TextField>
            </VBox>
            
            <!-- Email Field -->
            <VBox spacing="5.0">
                <Label text="Email:*" style="-fx-text-fill: #555;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Label>
                <TextField fx:id="emailField" promptText="example@email.com"
                          style="-fx-background-radius: 5; -fx-border-radius: 5; 
                                 -fx-border-color: #ddd; -fx-padding: 10;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </TextField>
            </VBox>
            
            <!-- Password Field -->
            <VBox spacing="5.0">
                <Label text="Mật khẩu:*" style="-fx-text-fill: #555;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Label>
                <PasswordField fx:id="passwordField" promptText="Tối thiểu 6 ký tự"
                              style="-fx-background-radius: 5; -fx-border-radius: 5; 
                                     -fx-border-color: #ddd; -fx-padding: 10;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </PasswordField>
            </VBox>
            
            <!-- Confirm Password Field -->
            <VBox spacing="5.0">
                <Label text="Xác nhận mật khẩu:*" style="-fx-text-fill: #555;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Label>
                <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại mật khẩu"
                              style="-fx-background-radius: 5; -fx-border-radius: 5; 
                                     -fx-border-color: #ddd; -fx-padding: 10;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </PasswordField>
            </VBox>
            
            <!-- Role Selection -->
            <VBox spacing="5.0">
                <Label text="Vai trò:*" style="-fx-text-fill: #555;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Label>
                <ComboBox fx:id="roleComboBox" promptText="Chọn vai trò" maxWidth="Infinity"
                         style="-fx-background-radius: 5; -fx-border-radius: 5; 
                                -fx-border-color: #ddd;"/>
            </VBox>
            
            <!-- Error/Success Label -->
            <Label fx:id="messageLabel" wrapText="true" visible="false">
                <font>
                    <Font size="12.0"/>
                </font>
            </Label>
            
            <!-- Buttons -->
            <HBox spacing="10.0" alignment="CENTER">
                <Button fx:id="registerButton" text="ĐĂNG KÝ" onAction="#handleRegister"
                       prefWidth="120.0" prefHeight="40.0"
                       style="-fx-background-color: #27ae60; -fx-text-fill: white; 
                              -fx-background-radius: 5; -fx-font-weight: bold;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Button>
                
                <Button fx:id="backToLoginButton" text="QUAY LẠI" onAction="#handleBackToLogin"
                       prefWidth="120.0" prefHeight="40.0"
                       style="-fx-background-color: #95a5a6; -fx-text-fill: white; 
                              -fx-background-radius: 5; -fx-font-weight: bold;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Button>
            </HBox>
        </VBox>
        
        <!-- Footer -->
        <Label text="© 2025 - Đồ án Lập trình Mạng" style="-fx-text-fill: #95a5a6;">
            <font>
                <Font size="11.0"/>
            </font>
        </Label>
    </VBox>
</AnchorPane>