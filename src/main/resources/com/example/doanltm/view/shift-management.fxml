<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.doanltm.Controller.ShiftManagementController"
            prefWidth="1000.0" prefHeight="680.0" stylesheets="@../styles/admin.css">
    <top>
        <VBox spacing="10" style="-fx-padding: 10;">
            <HBox spacing="10" styleClass="control-bar" alignment="CENTER_LEFT">
                <Label text="Quản lý ca làm" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField" promptText="Tìm kiếm mô tả/giờ..."/>
                <Button text="Làm mới" onAction="#handleRefresh" styleClass="outline-btn"/>
                <Button text="➕ Thêm" onAction="#handleAdd" styleClass="primary-btn"/>
                <Button text="✎ Sửa" onAction="#handleEdit"/>
                <Button text="🗑️ Xóa" onAction="#handleDelete" styleClass="danger-btn"/>
            </HBox>
            <Separator/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Trạng thái ca làm trong tháng" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="refreshMonthBtn" text="🔄 Làm mới" onAction="#handleMonthRefresh" styleClass="outline-btn"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="15">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <!-- Bảng danh sách ca làm -->
            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <Label text="Danh sách ca làm" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #1f2937;"/>
                <TableView fx:id="table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="Mã" prefWidth="60"/>
                        <TableColumn fx:id="colMoTa" text="Mô tả" prefWidth="220"/>
                        <TableColumn fx:id="colGioBD" text="Giờ BĐ" prefWidth="120"/>
                        <TableColumn fx:id="colGioKT" text="Giờ KT" prefWidth="120"/>
                        <TableColumn fx:id="colMax" text="Tối đa" prefWidth="80"/>
                        <TableColumn fx:id="colDaDK" text="Đã ĐK (hôm nay)" prefWidth="140"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
            
            <Separator/>
            
            <!-- Bảng trạng thái ca theo tháng -->
            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <Label text="Trạng thái ca làm trong tháng (scroll ngang để xem năy)" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #1f2937;"/>
                <ScrollPane hbarPolicy="ALWAYS" vbarPolicy="AS_NEEDED" fitToHeight="false" fitToWidth="true" VBox.vgrow="ALWAYS">
                    <TableView fx:id="monthTable" style="-fx-font-size: 9; -fx-fixed-cell-size: 35;"/>
                </ScrollPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>
