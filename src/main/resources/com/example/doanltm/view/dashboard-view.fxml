<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane minHeight="600.0" minWidth="800.0" prefHeight="800.0" prefWidth="1200.0" styleClass="main-container" stylesheets="@../styles/dashboard.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.doanltm.Controller.EnhancedUserDashboardController">

    <!-- Professional Header Bar -->
    <top>
        <HBox alignment="CENTER" spacing="20" styleClass="header-bar">
            <Label style="-fx-text-fill: white; -fx-font-size: 24;" text="🏢" />

            <Region HBox.hgrow="ALWAYS" />

            <Label styleClass="header-title" text="Hệ Thống Quản Lý Lịch Làm Việc" wrapText="true" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- User Info & Actions -->
            <HBox alignment="CENTER" spacing="15">
                <MenuButton styleClass="btn, btn-outline" text="👤 Tài khoản">
                    <items>
                        <MenuItem onAction="#handlePersonalStats" text="📊 Thống kê cá nhân" />
                        <MenuItem onAction="#handleSettings" text="⚙ Cài đặt" />
                        <SeparatorMenuItem />
                        <MenuItem onAction="#handleChangePassword" text="🔑 Đổi mật khẩu" />
                        <MenuItem onAction="#handleHelp" text="📝 Hướng dẫn" />
                    </items>
                </MenuButton>
                <Label fx:id="userNameLabel" styleClass="header-user-info" text="Nhân viên" />
                <Button onAction="#handleLogout" styleClass="btn, btn-danger" text="🚪 Đăng xuất" />
            </HBox>
        </HBox>
    </top>
   <bottom>

       <VBox>
           <ScrollPane fx:id="mainScrollPane" fitToWidth="true" hbarPolicy="AS_NEEDED" styleClass="scroll-pane" vbarPolicy="AS_NEEDED" BorderPane.alignment="CENTER">
               <VBox styleClass="content-area">

                   <!-- Registration Cards -->
                   <HBox alignment="TOP_CENTER" spacing="25" styleClass="cards-container">

                       <!-- Regular Shift Card -->
                       <VBox maxWidth="500" minWidth="350" prefWidth="450" styleClass="card" HBox.hgrow="ALWAYS">
                           <VBox styleClass="card-header">
                               <Label styleClass="card-title" text="📋 Đăng Ký Ca Bình Thường" wrapText="true" />
                               <Label styleClass="text-muted" text="Đăng ký ca làm việc có sẵn trong hệ thống" wrapText="true" />
                           </VBox>

                           <VBox spacing="20" styleClass="card-body">
                               <VBox styleClass="form-group">
                                   <Label styleClass="form-label" text="Ngày làm việc" />
                                   <DatePicker fx:id="ngayLamCaBinhThuongPicker" promptText="Chọn ngày làm việc" />
                               </VBox>

                               <VBox styleClass="form-group">
                                   <Label styleClass="form-label" text="Ca làm việc" />
                                   <ComboBox fx:id="caLamComboBox" maxWidth="Infinity" promptText="Chọn ca làm việc" />
                                   <Label fx:id="caLamInfoLabel" styleClass="text-muted" text="" />
                               </VBox>

                               <Button fx:id="dangKyCaBinhThuongButton" maxWidth="Infinity" onAction="#handleDangKyCaBinhThuong" styleClass="btn, btn-success" text="📋 Đăng Ký Ca Bình Thường" />

                               <Label fx:id="messageCaBinhThuongLabel" visible="false" wrapText="true" />
                           </VBox>
                       </VBox>

                       <!-- Flexible Shift Card -->
                       <VBox maxWidth="500" minWidth="350" prefWidth="450" styleClass="card" HBox.hgrow="ALWAYS">
                           <VBox styleClass="card-header">
                               <Label styleClass="card-title" text="⚡ Đăng Ký Ca Gãy" wrapText="true" />
                               <Label styleClass="text-muted" text="Đăng ký ca làm việc linh hoạt theo thời gian cá nhân" wrapText="true" />
                           </VBox>

                           <VBox spacing="20" styleClass="card-body">
                               <VBox styleClass="form-group">
                                   <Label styleClass="form-label" text="Ngày làm việc" />
                                   <DatePicker fx:id="ngayLamCaGayPicker" promptText="Chọn ngày làm việc" />
                               </VBox>

                               <HBox spacing="15">
                                   <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                                       <Label styleClass="form-label" text="Giờ bắt đầu" />
                                       <HBox alignment="CENTER" spacing="5">
                                           <Spinner fx:id="gioBatDauSpinner" editable="true" minWidth="80" prefWidth="80" styleClass="spinner" />
                                           <Label styleClass="text-bold" text=":" />
                                           <Spinner fx:id="phutBatDauSpinner" editable="true" minWidth="80" prefWidth="80" styleClass="spinner" />
                                       </HBox>
                                   </VBox>

                                   <VBox styleClass="form-group" HBox.hgrow="ALWAYS">
                                       <Label styleClass="form-label" text="Giờ kết thúc" />
                                       <HBox alignment="CENTER" spacing="5">
                                           <Spinner fx:id="gioKetThucSpinner" editable="true" minWidth="80" prefWidth="80" styleClass="spinner" />
                                           <Label styleClass="text-bold" text=":" />
                                           <Spinner fx:id="phutKetThucSpinner" editable="true" minWidth="80" prefWidth="80" styleClass="spinner" />
                                       </HBox>
                                   </VBox>
                               </HBox>

                               <!-- Add spacing to align with regular shift button -->
                               <Region prefHeight="20" />

                               <Button fx:id="dangKyCaGayButton" maxWidth="Infinity" onAction="#handleDangKyCaGay" styleClass="btn, btn-warning" text="⚡ Đăng Ký Ca Gãy" />

                               <Label fx:id="messageCaGayLabel" visible="false" wrapText="true" />
                           </VBox>
                       </VBox>
                   </HBox>

                   <!-- My Schedule Section -->
                   <VBox styleClass="card" VBox.vgrow="ALWAYS">
                       <VBox styleClass="card-header">
                           <HBox alignment="CENTER_LEFT" spacing="15">
                               <Label styleClass="card-title" text="📋 Lịch Làm Việc Của Tôi" />
                               <Region HBox.hgrow="ALWAYS" />

                               <!-- Auto-refresh indicator -->
                               <Label styleClass="text-success, text-bold" text="🔄 Tự động cập nhật" />
                           </HBox>
                       </VBox>

                       <!-- Search and Filter Bar -->
                       <HBox styleClass="search-bar">
                           <HBox alignment="CENTER_LEFT" spacing="15" HBox.hgrow="ALWAYS">
                               <Label styleClass="form-label" text="🔍 Tìm kiếm:" />
                               <TextField fx:id="searchField" onKeyReleased="#handleSearch" promptText="Tìm kiếm theo mô tả, ngày..." styleClass="search-field" />

                               <Label styleClass="form-label" text="Lọc:" />
                               <ComboBox fx:id="statusFilterCombo" onAction="#handleFilter" promptText="Tất cả trạng thái" styleClass="filter-combo" />

                               <ComboBox fx:id="typeFilterCombo" onAction="#handleFilter" promptText="Tất cả loại ca" styleClass="filter-combo" />

                               <Button onAction="#handleManualRefresh" styleClass="btn, btn-primary" text="🔄 Làm mới dữ liệu" />
                           </HBox>
                       </HBox>

                       <!-- Enhanced Table -->
                       <VBox styleClass="card-body" VBox.vgrow="ALWAYS">
                           <TableView fx:id="dangKyTableView" minHeight="300" prefHeight="400" VBox.vgrow="ALWAYS">
                               <columns>
                                   <TableColumn fx:id="colNgayLam" maxWidth="Infinity" minWidth="90" prefWidth="90" text="Ngày Làm" />
                                   <TableColumn fx:id="colLoaiCa" maxWidth="Infinity" minWidth="80" prefWidth="80" text="Loại Ca" />
                                   <TableColumn fx:id="colCaLam" maxWidth="Infinity" minWidth="120" prefWidth="150" text="Mô Tả" />
                                   <TableColumn fx:id="colGioBatDau" maxWidth="Infinity" minWidth="70" prefWidth="70" text="Giờ BĐ" />
                                   <TableColumn fx:id="colGioKetThuc" maxWidth="Infinity" minWidth="70" prefWidth="70" text="Giờ KT" />
                                   <TableColumn fx:id="colThoiGianDangKy" maxWidth="Infinity" minWidth="110" prefWidth="120" text="Thời Gian ĐK" />
                                   <TableColumn fx:id="colTrangThai" maxWidth="Infinity" minWidth="90" prefWidth="100" text="Trạng Thái" />
                                   <TableColumn fx:id="colAction" maxWidth="Infinity" minWidth="90" prefWidth="90" text="Hành Động" />
                               </columns>
                               <columnResizePolicy>
                                   <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                               </columnResizePolicy>
                           </TableView>
                       </VBox>
                   </VBox>
                   <HBox spacing="15" alignment="CENTER">
                       <Button text="👤 Thông tin cá nhân" onAction="#showPersonalInfoAnalysts"/>
                       <Button text="⚙ Cài đặt tài khoản" onAction="#showSettings"/>
                   </HBox>
                   <AnchorPane fx:id="contentArea" prefHeight="400"
                               style="-fx-background-color: #f8f9fa; -fx-border-color: #ccc;">
                       <children>
                           <Label text="👋 Hello World! Đây là Trang 1 (mặc định)."
                                  layoutX="30" layoutY="30"
                                  style="-fx-font-size: 18; -fx-text-fill: #2c3e50;"/>
                       </children>
                   </AnchorPane>

               </VBox>
           </ScrollPane>
           <!-- ✅ Thêm container động ở đây -->

       </VBox>
   </bottom>

</BorderPane>
